# .env.example
# --- Mandatory Configuration for ToDoList Project ---

# Limits the maximum number of projects the user can create.
MAX_NUMBER_OF_PROJECT=5

# Limits the maximum number of tasks any single project can hold.
MAX_NUMBER_OF_TASK=20

# --- Database Configuration for Phase 2 ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=todolist
DB_USER=todolist_user
DB_PASSWORD=secret
DATABASE_URL=postgresql+psycopg2://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
